+void OCAPFAI::Display_Status_FAI()
+{
+	if (gCap_FAI.nLotCycle_FAI < 0 || gCap_FAI.nLotCycle_FAI > 49) return;
+	int nIx = (gCap_FAI.nLotCycle_FAI + 49) % 50;
